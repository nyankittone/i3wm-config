# i3 config file for setting up gaps for the workspaces, and their keybinds.

# disabling window title bars, and setting window border size
for_window [workspace="^.*$"] border pixel 2 

# setting up gaps
gaps inner 12
gaps outer 12

# making borders not get drawn on workspaces with no gaps
smart_borders no_gaps

bindsym $mod+g gaps inner current toggle 24; gaps outer current toggle 6
