set $scrot_base "scrot"

mode "screenshot" {
    bindsym Escape mode "default"
    bindsym $mod+p mode "default"
    bindsym Return mode "default"
    bindsym BackSpace mode "default"

    bindsym c mode "screenshot > clipboard"
    bindsym f mode "screenshot > file"
}

# TODO: set up notify-send, pls
mode "screenshot > clipboard" {
    bindsym Escape mode "default"
    bindsym $mod+p mode "default"
    bindsym Return mode "default"
    bindsym BackSpace mode "screenshot"

    bindsym 1 exec --no-startup-id sleep 0.1 && take_screenshot.sh clipboard 1; mode "default"
    bindsym 2 exec --no-startup-id sleep 0.1 && take_screenshot.sh clipboard 2; mode "default"
    bindsym a exec --no-startup-id sleep 0.1 && take_screenshot.sh clipboard all; mode "default"
    bindsym s exec --no-startup-id sleep 0.1 && take_screenshot.sh clipboard select; mode "default"
}

mode "screenshot > file" {
    bindsym Escape mode "default"
    bindsym $mod+p mode "default"
    bindsym Return mode "default"
    bindsym BackSpace mode "screenshot"

    bindsym 1 exec --no-startup-id sleep 0.1 && take_screenshot.sh file 1; mode "default"
    bindsym 2 exec --no-startup-id sleep 0.1 && take_screenshot.sh file 2; mode "default"
    bindsym a exec --no-startup-id sleep 0.1 && take_screenshot.sh file all; mode "default"
    bindsym s exec --no-startup-id sleep 0.1 && take_screenshot.sh file select; mode "default"
}

bindsym $mod+p mode "screenshot"

